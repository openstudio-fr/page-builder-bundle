{% extends 'base.html.twig' %}

{% block title %}Page builder demo{% endblock %}

{% block body %}
    {{ form_start(form, { attr: { 'data-testid': 'page-form' } }) }}
        {{ form_widget(form.projectData) }}
        {{ form_widget(form.html) }}
        {{ form_widget(form.css) }}

        <div style="height: 80vh;">
            {{ component('PageBuilder', { form: form, context: 'demo-page', options: { wrapperClasses: 'content' } }) }}
        </div>

        <p style="padding: 1rem;">
            <button type="submit" data-testid="persist">Persist</button>
        </p>
    {{ form_end(form) }}
{% endblock %}
