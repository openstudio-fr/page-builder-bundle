{
    "name": "openstudio/page-builder-bundle",
    "description": "GrapesJS page builder for Symfony 7 — standalone, framework-agnostic bundle.",
    "type": "symfony-bundle",
    "license": "LGPL-3.0-or-later",
    "require": {
        "php": ">=8.3",
        "symfony/asset-mapper": "^7.4",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/stimulus-bundle": "^2.31",
        "symfony/twig-bundle": "^7.4",
        "symfony/ux-twig-component": "^2.31 || ^3.0",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "vimeo/psalm": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "OpenStudio\\PageBuilderBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenStudio\\PageBuilderBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "require": "^7.4"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
